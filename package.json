{
  "name": "@lovedolove/veyra",
  "description": "Veyra — Engineering Intelligence for Coding Agents. Learns engineering experience from agent work, remembers what is reliable, recalls it on its own initiative, and keeps it evidence-backed and isolated per DSH workspace.",
  "version": "0.6.0",
  "type": "module",
  "main": "src/plugin.mjs",
  "exports": {
    ".": "./src/plugin.mjs",
    "./dsh": "./src/plugin.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "skills",
    "client.js",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {},
  "devDependencies": {
    "@lovedolove/dsh-codebase-memory-mcp": "^0.1.10"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "memory",
    "engineering-brain",
    "engineering-intelligence",
    "coding-agents",
    "hybrid-search",
    "rag",
    "plugin"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoveDoLove/Veyra.git"
  },
  "bugs": {
    "url": "https://github.com/LoveDoLove/Veyra/issues"
  },
  "homepage": "https://github.com/LoveDoLove/Veyra#readme",
  "engines": {
    "node": ">=22.12.0 <25.0.0",
    "dsh": ">=0.1.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-workspace-controller"
      ]
    }
  },
  "peerDependencies": {
    "@lovedolove/dsh-codebase-memory-mcp": "^0.1.6",
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@lovedolove/dsh-codebase-memory-mcp": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
